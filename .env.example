# ===== SonicSentinel AI — Environment Template =====
# The backend reads `ml-service/.env`; see `ml-service/.env.example` for the
# full backend template. This root file only holds what Vite needs.
# NEVER commit real secrets.

# --- Database (MongoDB Atlas / local) ---
# Copy ml-service/.env.example for MONGO_URI. Preferred Atlas form:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Legacy form also works:
#   mongodb://user:pass@host:27017/?ssl=true&replicaSet=rs0&authSource=admin&appName=Cluster0
MONGO_URI=
MONGO_DB=sonic_sentinel
MONGO_TIMEOUT_MS=6000

# --- Server ---
ML_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./ml-service/data/uploads
MAX_UPLOAD_BYTES=104857600

# --- Sessions & Security ---
SESSION_DAYS=7
COOKIE_SECURE=false
FIRST_USER_ADMIN=true

# --- OAuth: Google (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- OAuth: Facebook (https://developers.facebook.com/apps) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

# --- Models ---
MODEL_PATH=./ml-service/models/python_model/model.pkl
MODEL_METADATA_PATH=./ml-service/models/python_model/metadata.json
TEACHABLE_MACHINE_MODEL_URL=

# --- Detection / Alerts tuning ---
MODEL_CONFIDENCE_THRESHOLD=0.75
ALERT_CONFIDENCE_THRESHOLD=0.85
# Min seconds between skipped duplicate alerts of the same severity+class per user
ALERT_COOLDOWN_SECONDS=60