# ============================================================
#  SonicSentinel AI - backend environment template
#  Copy to  ml-service/.env  and fill in real values.
#  This file is committed on purpose and must stay secret-free.
#  The backend reads it via python-dotenv on import
#  (see ml-service/app/main.py: load_dotenv(ROOT / ".env")).
# ============================================================

# ---------- Database (REQUIRED - the app will not boot without it) ----------
# Atlas: Atlas UI -> Database Access -> any user -> "Connect" -> copy the
# standard connection string. Prefer the mongodb+srv:// form, it is the only
# one that survives a cluster move or a shard change.
#
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Local mongod example (no TLS):
#   MONGO_URI=mongodb://localhost:27017
MONGO_URI=
MONGO_DB=sonic_sentinel

# How long the driver waits for a reachable server before giving up.
MONGO_TIMEOUT_MS=6000

# ---------- Server ----------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_DAYS=7
# Set to true only when served over HTTPS.
COOKIE_SECURE=false
# The first account to register becomes "admin" while this is true.
FIRST_USER_ADMIN=true

# ---------- OAuth: Google ----------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must equal GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------- OAuth: Facebook ----------
# https://developers.facebook.com/apps -> Facebook Login -> Settings
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

# ---------- Models / storage ----------
# Optional. Defaults live in ml-service/app/main.py.
# MODEL_PATH=
# MODEL_METADATA_PATH=
# UPLOAD_DIR=
MAX_UPLOAD_BYTES=104857600

# ---------- Detection / alert tuning ----------
# Below these confidences nothing is flagged as noteworthy.
MODEL_CONFIDENCE_THRESHOLD=0.75
ALERT_CONFIDENCE_THRESHOLD=0.85
# Seconds to suppress a duplicate alert of the same severity + label.
ALERT_COOLDOWN_SECONDS=60
